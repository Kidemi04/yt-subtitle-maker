{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port 8081",
    "web": "expo start --web --port 8081",
    "build": "expo export --platform web --output-dir dist",
    "build:backend": "rm -rf src-tauri/backend-dist src-tauri/.pyinstaller-work && mkdir -p src-tauri/backend-dist && touch src-tauri/backend-dist/.gitkeep && ../../backend/.venv/bin/pyinstaller --noconfirm --distpath src-tauri --workpath src-tauri/.pyinstaller-work ../../backend/packaging/backend.spec && touch src-tauri/backend-dist/.gitkeep",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "pnpm build:backend && tauri build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@tamagui/animations-css": "1.115.5",
    "@tamagui/lucide-icons": "1.115.5",
    "@tamagui/shorthands": "1.115.5",
    "@yt-subtitle-maker/api-client": "workspace:*",
    "@yt-subtitle-maker/ui": "workspace:*",
    "zustand": "^4.5.5",
    "expo": "51.0.39",
    "expo-constants": "16.0.2",
    "expo-font": "^12.0.10",
    "expo-linking": "6.3.1",
    "expo-router": "3.5.24",
    "expo-status-bar": "1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "0.19.13",
    "tamagui": "1.115.5"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@tauri-apps/cli": "2.1.0",
    "@types/react": "18.2.79",
    "babel-preset-expo": "11.0.15",
    "typescript": "5.3.3"
  }
}
